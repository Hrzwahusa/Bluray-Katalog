{
  "name": "bluray-katalog-android",
  "version": "1.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "build": "npx eas-cli build --platform android",
    "build:production": "npx eas-cli build --platform android --profile production",
    "build:production:local": "cd android && gradlew.bat bundleRelease && node ../../../scripts/sync-play-store-release-notes.mjs",
    "submit:production": "npx eas-cli submit --platform android --profile production",
    "release:internal": "npm run build:production && npm run submit:production",
    "eas-build-on-success": "node ../../scripts/sync-play-store-release-notes.mjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@bluray-katalog/shared": "*",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "2.45.4",
    "expo": "^56.0.5",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-file-system": "~56.0.7",
    "expo-image-picker": "~56.0.14",
    "expo-linking": "~56.0.12",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.14",
    "tailwindcss": "^3.4.15",
    "typescript": "~6.0.3"
  }
}
