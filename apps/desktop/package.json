{
  "name": "bluray-katalog-desktop",
  "version": "1.1.3",
  "description": "BluRay-Katalog Desktop-App (Windows & Linux)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir --config.win.signAndEditExecutable=false",
    "zip:win-unpacked": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path 'release/BluRay-Katalog-win-unpacked.zip') { Remove-Item 'release/BluRay-Katalog-win-unpacked.zip' -Force }; Compress-Archive -Path 'release/win-unpacked/*' -DestinationPath 'release/BluRay-Katalog-win-unpacked.zip' -CompressionLevel Optimal\"",
    "package:portable": "npm run package:dir && npm run zip:win-unpacked"
  },
  "dependencies": {
    "@bluray-katalog/shared": "*",
    "@google/genai": "^2.6.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "2.45.4",
    "electron-store": "^8.2.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "de.bluray-katalog.app",
    "productName": "BluRay Katalog",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
