{
  "expo": {
    "name": "BluRay Katalog",
    "slug": "bluray-katalog",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bluray-katalog",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "package": "com.bluraykatalog",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BluRay Katalog benötigt Kamerazugriff zum Scannen von Blu-ray Covers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BluRay Katalog benötigt Zugriff auf Fotos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
